# ============================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env và điền thông tin thật trước khi chạy
# ============================================================================

# 1. Cổng thanh toán tự động SePay (VietQR)
SEPAY_API_TOKEN= ****************

# 2. Dịch vụ gửi Email tự động Resend
RESEND_API_KEY=re_********************************
EMAIL_FROM=Hồ Minh Thuận — Sportfit.pro <thuan@mail.bongdemannhien.io.vn>
EMAIL_REPLY_TO=thuanho1221@gmail.com
PAYMENT_URL=https://www.bongdemannhien.io.vn/#sale-off

# 3. Cơ sở dữ liệu Turso (LibSQL) trên Server thật
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 4. Mật khẩu trang Quản trị /admin
ADMIN_PASSWORD=your_strong_admin_password_here
